import os
from building import *

cwd = GetCurrentDir()
app_dir = os.path.join(cwd, 'app')
ezip_dir = os.path.join(cwd, 'ezip')
src = []
inc = [cwd, app_dir, os.path.join(cwd, 'asset'), ezip_dir]

for root, dirs, files in os.walk(app_dir):
    for name in files:
        if name.endswith('.c') and name != 'sim_sifli.c':
            src.append(os.path.join(root, name))
    inc.append(root)

if os.path.isdir(ezip_dir):
    for name in os.listdir(ezip_dir):
        if name.endswith('.c'):
            src.append(os.path.join(ezip_dir, name))

group = DefineGroup('lvgl_ai_app', src, depend=['PKG_USING_LITTLEVGL2RTT'], CPPPATH=inc)
Return('group')
