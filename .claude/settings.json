{
  "permissions": {
    "allow": [
      "Bash(python -I core/tools/lint.py check*)",
      "Bash(python -I core/tools/lint.py format*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -I \"${CLAUDE_PROJECT_DIR}/core/tools/lint.py\" hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
